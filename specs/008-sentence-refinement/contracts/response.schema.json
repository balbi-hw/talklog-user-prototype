{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefinementResponse",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["ok", "result"],
      "properties": { "ok": { "const": true }, "result": { "$ref": "./result.schema.json" } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code"],
          "properties": { "code": { "enum": ["invalid-input", "too-large", "unsupported-format", "failed", "timeout", "limit", "network"] } }
        }
      }
    }
  ]
}
